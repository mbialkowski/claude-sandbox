extends Node
## Game data loaded from res://data (generated by tools/build_remake_data.py) and the player's settings.
## Autoloaded as "Data"; the simulation classes receive it as a parameter so tests can create their own.

const DATA_DIR := "res://data/"
const SETTINGS_PATH := "user://settings.cfg"

var game: Dictionary
var texts := {}                 # "pl"/"en" -> Array of message strings
var scripts: Dictionary         # script_logic.json
var script_by_id := {}          # script id -> handler
var item_use_by_id := {}
var missing_item_by_id := {}

# frame descriptors, one entry per DATA03 record (separators have duration -1)
var desc_dur := PackedInt32Array()
var desc_off := PackedInt32Array()
var desc_box := PackedInt32Array()     # x0,y0,x1,y1 per descriptor
var frame_rect := []                    # Rect2 per descriptor (null for separators)
var group_first := PackedInt32Array()
var tile_types := PackedInt32Array()
var tile_boxes := PackedInt32Array()    # x0,y0,x1,y1 per tile
var tile_seq_flat := PackedInt32Array()
var tile_seq_start := PackedInt32Array()
var palettes := {}                      # name -> PackedByteArray (768, 8-bit)
var font: Dictionary
var glyphs := {}                        # unicode -> [x, y, width]

var tex_sprites: Texture2D
var tex_sprites_mask: Texture2D
var tex_platform: Texture2D
var tex_background: Texture2D
var tex_hud: Texture2D
var tex_font_body: Texture2D
var tex_font_outline: Texture2D
var sounds := []                        # AudioStreamWAV per sound id
var music := {}

var settings := {
	"language": "pl",
	"dim_neighbours": true,
	"smooth_scaling": true,
	"touch_controls": "auto",           # auto / on / off
	"sfx_volume": 0.8,
	"music_volume": 0.7,
	"game_music": true,                 # the remake's addition: the two modules while playing
	"show_neighbours": true,
	"room_edges": "classic",            # classic: the original's room transitions; seamless: no jump
}
var loaded := false


func _ready() -> void:
	load_all()


func load_all(with_media := true) -> void:
	if loaded:
		return
	game = _json("game.json")
	_intify_rooms()
	texts["pl"] = _json("text_pl.json")
	texts["en"] = _json("text_en.json")
	scripts = _json("scripts.json")
	for h in scripts["scripts"]:
		script_by_id[int(h["id"])] = h
	for h in scripts["item_use"]:
		item_use_by_id[int(h["id"])] = h
	for h in scripts["missing_item"]:
		missing_item_by_id[int(h["id"])] = h
	for d in game["desc"]:
		desc_dur.append(int(d[0]))
		desc_off.append(int(d[1]))
		for k in range(2, 6):
			desc_box.append(int(d[k]))
	for r in game["frames"]:
		frame_rect.append(null if r == null else Rect2(r[0], r[1], r[2], r[3]))
	for v in game["group_first"]:
		group_first.append(int(v))
	for v in game["tile_types"]:
		tile_types.append(int(v))
	for b in game["tile_boxes"]:
		for v in b:
			tile_boxes.append(int(v))
	for v in game["tile_seq_flat"]:
		tile_seq_flat.append(int(v))
	for v in game["tile_seq_start"]:
		tile_seq_start.append(int(v))
	for k in game["palettes"]:
		var p := PackedByteArray()
		for v in game["palettes"][k]:
			p.append(int(v))
		palettes[k] = p
	font = game["font"]
	for k in font["glyphs"]:
		glyphs[int(k)] = font["glyphs"][k]
	if with_media:
		_load_media()
	_load_settings()
	loaded = true


func _intify_rooms() -> void:
	"""JSON numbers arrive as floats; the simulation needs ints (16.16 values fit in 32 bits)."""
	for room in game["rooms"]:
		room["bg"] = PackedInt32Array(room["bg"])
		room["tiles"] = PackedInt32Array(room["tiles"])
		var anims := []
		for a in room["anims"]:
			anims.append(PackedInt32Array(a))
		room["anims"] = anims
		for o in room["objects"]:
			for k in o.keys():
				if k == "steps":
					var steps := []
					for st in o["steps"]:
						steps.append(PackedInt32Array(st))
					o["steps"] = steps
				else:
					o[k] = int(o[k])


func _json(name: String):
	var txt := FileAccess.get_file_as_string(DATA_DIR + name)
	if txt.is_empty():
		push_error("cannot read " + DATA_DIR + name)
		return {}
	return JSON.parse_string(txt)


func _load_media() -> void:
	tex_sprites = load(DATA_DIR + "sprites.png")
	tex_sprites_mask = load(DATA_DIR + "sprites_mask.png")
	tex_platform = load(DATA_DIR + "tiles_platform.png")
	tex_background = load(DATA_DIR + "tiles_background.png")
	tex_hud = load(DATA_DIR + "hud_panel.png")
	tex_font_body = load(DATA_DIR + "font_body.png")
	tex_font_outline = load(DATA_DIR + "font_outline.png")
	var blob := FileAccess.get_file_as_bytes(DATA_DIR + "sounds.bin")
	for s in game["sounds"]:
		var w := AudioStreamWAV.new()
		w.format = AudioStreamWAV.FORMAT_8_BITS
		w.mix_rate = int(s["rate"])
		w.stereo = false
		var off := int(s["offset"])
		var n := int(s["length"])
		w.data = blob.slice(off, off + n)
		if s["loop"]:
			w.loop_mode = AudioStreamWAV.LOOP_FORWARD
			w.loop_begin = int(s["loop_start"])
			w.loop_end = n
		sounds.append(w)
	music["title"] = load(DATA_DIR + "music_title.ogg")
	music["intro"] = load(DATA_DIR + "music_intro.ogg")
	for k in music:
		if music[k]:
			music[k].loop = true                       # the intro and the credits end before the tune


# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------
func text(i: int) -> String:
	var lang: String = settings["language"]
	var t: Array = texts.get(lang, texts["pl"])
	return t[i] if i < t.size() else ""


func item_name(item: int) -> String:
	var it: Dictionary = game["items"][item]
	return it["en"] if settings["language"] == "en" else it["pl"]


func is_sound_looping(id: int) -> bool:
	return id >= 0 and id < game["sounds"].size() and game["sounds"][id]["loop"]


const SETTINGS_VERSION := 2


func _load_settings() -> void:
	"""Polish (the original texts) unless the player chose English in the options."""
	var cfg := ConfigFile.new()
	if cfg.load(SETTINGS_PATH) == OK:
		for k in settings:
			settings[k] = cfg.get_value("settings", k, settings[k])
		if int(cfg.get_value("settings", "version", 1)) < SETTINGS_VERSION:
			settings["language"] = "pl"                # version 1 picked English from the system locale


func save_settings() -> void:
	var cfg := ConfigFile.new()
	for k in settings:
		cfg.set_value("settings", k, settings[k])
	cfg.set_value("settings", "version", SETTINGS_VERSION)
	cfg.save(SETTINGS_PATH)
